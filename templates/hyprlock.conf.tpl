# Generated by tp-theme (@THEME_NAME@). Do not edit by hand; edit themes/@THEME_ID@/palette.sh

general {
  hide_cursor = true
  ignore_empty_input = true
}

background {
  monitor =
  path = @STATE_DIR@/current/wallpaper.png
  blur_passes = 3
  blur_size = 7
  noise = 0.02
  brightness = 0.8
}

input-field {
  monitor =
  size = 300, 54
  outline_thickness = @BORDER@
  dots_size = 0.22
  dots_spacing = 0.35
  dots_center = true
  outer_color = rgb(@ACCENT_H@)
  inner_color = rgba(@BASE_H@dd)
  font_color = rgb(@TEXT_H@)
  check_color = rgb(@GREEN_H@)
  fail_color = rgb(@RED_H@)
  fade_on_empty = true
  placeholder_text = <span foreground="##@SUBTEXT_H@">Password</span>
  fail_text = $FAIL <b>($ATTEMPTS)</b>
  rounding = @ROUNDING@
  position = 0, -120
  halign = center
  valign = center
}

label {
  monitor =
  text = $TIME
  color = rgb(@TEXT_H@)
  font_size = 96
  font_family = @FONT_UI@ Bold
  position = 0, 120
  halign = center
  valign = center
}

label {
  monitor =
  text = cmd[update:60000] date +"%A, %d %B"
  color = rgb(@SUBTEXT_H@)
  font_size = 20
  font_family = @FONT_UI@
  position = 0, 40
  halign = center
  valign = center
}
