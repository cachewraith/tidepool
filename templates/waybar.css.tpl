/* Generated by tp-theme (@THEME_NAME@). Do not edit by hand; edit themes/@THEME_ID@/palette.sh */

@define-color base     @BASE@;
@define-color mantle   @MANTLE@;
@define-color surface  @SURFACE@;
@define-color overlay  @OVERLAY@;
@define-color text     @TEXT@;
@define-color subtext  @SUBTEXT@;
@define-color accent   @ACCENT@;
@define-color accent2  @ACCENT2@;
@define-color on_accent @ON_ACCENT@;
@define-color green    @GREEN@;
@define-color yellow   @YELLOW@;
@define-color red      @RED@;
@define-color blue     @BLUE@;
@define-color mauve    @MAUVE@;

* {
  font-family: "@FONT_UI@", "JetBrains Mono", monospace;
  font-size: 13px;
  font-weight: 500;
  border: none;
  border-radius: 0;
  min-height: 0;
}

/* The bar itself is see-through. Each group below is a floating, blurred island. */
window#waybar {
  background: transparent;
  color: @text;
}

.modules-left,
.modules-center,
.modules-right {
  background: rgba(@BASE_RGB@, @BAR_ALPHA@);
  border: 1px solid rgba(@TEXT_RGB@, 0.10);
  border-radius: @BAR_RADIUS@px;
  padding: 2px 6px;
}

tooltip {
  background: rgba(@BASE_RGB@, 0.94);
  border: @BORDER@px solid @accent;
  border-radius: @INNER_RADIUS@px;
}
tooltip label { color: @text; padding: 2px 4px; }

/* Shared pill behavior */
#custom-logo, #window, #clock, #mpris, #pulseaudio, #network, #cpu, #memory,
#temperature, #battery, #custom-theme, #custom-game, #tray, #custom-power {
  padding: 0 10px;
  margin: 3px 2px;
  border-radius: @INNER_RADIUS@px;
  color: @text;
  transition: background 180ms ease-out, color 180ms ease-out;
}
#pulseaudio:hover, #network:hover, #custom-theme:hover, #custom-game:hover,
#custom-power:hover, #custom-logo:hover, #mpris:hover {
  background: rgba(@TEXT_RGB@, 0.12);
}

#custom-logo {
  color: @on_accent;
  background: @accent;
  font-size: 15px;
  padding: 0 12px;
}
#custom-logo:hover { background: @accent2; }

/* Workspaces */
#workspaces { margin: 0 2px; }
#workspaces button {
  padding: 0 9px;
  margin: 3px 2px;
  border-radius: @INNER_RADIUS@px;
  color: @subtext;
  background: transparent;
  transition: background 200ms ease-out, color 200ms ease-out;
}
#workspaces button:hover {
  background: rgba(@TEXT_RGB@, 0.12);
  color: @text;
}
#workspaces button.active {
  background: @accent;
  color: @on_accent;
  font-weight: 700;
  padding: 0 14px;
}
#workspaces button.urgent {
  background: @red;
  color: @on_accent;
}

#window { color: @subtext; }
window#waybar.empty #window { background: transparent; }

#clock { font-weight: 700; letter-spacing: 0.5px; }

/* Status colors, one hue per job so the right island reads at a glance */
#pulseaudio { color: @mauve; }
#pulseaudio.muted { color: @subtext; }
#network { color: @accent2; }
#network.disconnected { color: @red; }
#cpu { color: @blue; }
#memory { color: @green; }
#temperature { color: @yellow; }
#temperature.critical { color: @red; }
#mpris { color: @accent; }
#custom-theme { color: @accent; }
#custom-game { color: @subtext; }
#custom-game.on { color: @on_accent; background: @accent; }
#custom-power { color: @red; }

#battery { color: @green; }
#battery.charging, #battery.plugged { color: @accent2; }
#battery.warning:not(.charging) { color: @yellow; }
#battery.critical:not(.charging) { color: @red; }

#tray { padding: 0 8px; }
#tray > .passive { -gtk-icon-effect: dim; }
#tray > .needs-attention { -gtk-icon-effect: highlight; background: @red; }
