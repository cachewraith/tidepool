/* Generated by tp-theme (@THEME_NAME@). Do not edit by hand; edit themes/@THEME_ID@/palette.sh */

* {
  bg:        #@BASE_H@@WIN_ALPHA_HEX@;
  bg-alt:    #@SURFACE_H@@PANEL_ALPHA_HEX@;
  fg:        #@TEXT_H@;
  fg-dim:    #@SUBTEXT_H@;
  accent:    #@ACCENT_H@;
  on-accent: #@ON_ACCENT_H@;
  urgent:    #@RED_H@;

  font: "@FONT_UI@ 12";
  background-color: transparent;
  text-color: @fg;
}

window {
  transparency: "real";
  location: center;
  anchor: center;
  width: 640px;
  background-color: @bg;
  border: @BORDER@px;
  border-color: @accent;
  border-radius: @ROUNDING@px;
}

mainbox {
  padding: 18px;
  spacing: 14px;
  children: [ "inputbar", "message", "listview" ];
}

inputbar {
  background-color: @bg-alt;
  border-radius: @INNER_RADIUS@px;
  padding: 12px 16px;
  spacing: 12px;
  children: [ "prompt", "entry" ];
}
prompt { text-color: @accent; font: "@FONT_UI@ Bold 12"; }
entry {
  placeholder: "Search";
  placeholder-color: @fg-dim;
  cursor-color: @accent;
}

message {
  background-color: @bg-alt;
  border-radius: @INNER_RADIUS@px;
  padding: 10px 14px;
}
textbox { text-color: @fg-dim; }

listview {
  lines: 8;
  columns: 1;
  fixed-height: true;
  scrollbar: false;
  spacing: 4px;
  cycle: true;
}

element {
  padding: 10px 14px;
  spacing: 12px;
  border-radius: @INNER_RADIUS@px;
}
element normal.normal { background-color: transparent; text-color: @fg; }
element alternate.normal { background-color: transparent; text-color: @fg; }
element normal.active, element alternate.active { text-color: @accent; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element selected.normal, element selected.active {
  background-color: @accent;
  text-color: @on-accent;
}
element selected.urgent { background-color: @urgent; text-color: @on-accent; }
element-icon { size: 24px; background-color: transparent; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
