/* Generated by tp-theme (@THEME_NAME@). Do not edit by hand; edit themes/@THEME_ID@/palette.sh */

@define-color base     @BASE@;
@define-color mantle   @MANTLE@;
@define-color surface  @SURFACE@;
@define-color overlay  @OVERLAY@;
@define-color text     @TEXT@;
@define-color subtext  @SUBTEXT@;
@define-color accent   @ACCENT@;
@define-color accent2  @ACCENT2@;
@define-color on_accent @ON_ACCENT@;
@define-color red      @RED@;

* {
  font-family: "@FONT_UI@", "JetBrains Mono", monospace;
  font-size: 13px;
  transition: background 160ms ease-out, color 160ms ease-out;
}

.notification-row { outline: none; background: transparent; }
.notification-row:focus, .notification-row:hover { background: transparent; }

.notification {
  background: rgba(@BASE_RGB@, @BAR_ALPHA@);
  border: @BORDER@px solid @overlay;
  border-radius: @ROUNDING@px;
  margin: 6px 12px;
  padding: 0;
  box-shadow: none;
}
.notification.critical { border-color: @red; }
.notification-content { background: transparent; padding: 10px; border-radius: @ROUNDING@px; }
.notification .summary { color: @text; font-weight: 700; font-size: 14px; }
.notification .body { color: @subtext; }
.notification .time { color: @subtext; font-size: 11px; margin-right: 6px; }
.notification .app-icon, .notification .image { margin-right: 10px; }

.close-button {
  background: @surface;
  color: @text;
  border-radius: @INNER_RADIUS@px;
  min-width: 22px; min-height: 22px;
  margin: 8px;
  padding: 0;
}
.close-button:hover { background: @accent; color: @on_accent; }

/* In swaync 0.12 (GTK4) .notification-action is a container; the button sits inside it */
.notification-action { background: transparent; margin: 4px; padding: 0; }
.notification-action > button {
  background: @surface;
  color: @text;
  border: none;
  border-radius: @INNER_RADIUS@px;
  padding: 4px 10px;
}
.notification-action > button:hover { background: @accent; color: @on_accent; }

.notification-default-action, .notification-default-action:hover { background: transparent; }

/* Control center */
.control-center {
  background: rgba(@BASE_RGB@, @BAR_ALPHA@);
  border: @BORDER@px solid @accent;
  border-radius: @ROUNDING@px;
  margin: 8px;
  padding: 6px;
}
.control-center-list { background: transparent; }
.control-center .notification-row .notification { margin: 4px 6px; }

.widget-title { margin: 10px; color: @text; }
.widget-title > label { font-size: 16px; font-weight: 700; }
.widget-title > button {
  background: @surface; color: @text; border: none;
  border-radius: @INNER_RADIUS@px; padding: 4px 12px;
}
.widget-title > button:hover { background: @accent; color: @on_accent; }

.widget-dnd { margin: 6px 10px; color: @text; }
.widget-dnd switch {
  background: @surface; border-radius: @INNER_RADIUS@px; border: none;
}
.widget-dnd switch:checked { background: @accent; }
.widget-dnd switch slider { background: @text; border-radius: @INNER_RADIUS@px; }

:root { --mpris-album-art-icon-size: 64px; }  /* replaces the deprecated mpris "image-size" option */
.widget-mpris { margin: 6px 10px; }
.widget-mpris-player {
  background: @surface;
  border-radius: @INNER_RADIUS@px;
  padding: 8px;
}
.widget-mpris-title { font-weight: 700; color: @text; }
.widget-mpris-subtitle { color: @subtext; }

.widget-volume, .widget-backlight {
  background: @surface;
  border-radius: @INNER_RADIUS@px;
  margin: 6px 10px;
  padding: 8px 12px;
  color: @text;
}
trough { background: @overlay; border-radius: @INNER_RADIUS@px; min-height: 6px; }
highlight { background: @accent; border-radius: @INNER_RADIUS@px; }
slider { background: @text; border-radius: @INNER_RADIUS@px; min-width: 12px; min-height: 12px; }

progressbar trough { background: @overlay; }
progressbar progress { background: @accent; border-radius: @INNER_RADIUS@px; }
