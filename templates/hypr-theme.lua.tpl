-- Generated by tp-theme from themes/@THEME_ID@/palette.sh. Do not edit by hand.
-- Re-run:  tp-theme set @THEME_ID@
return {
  id   = "@THEME_ID@",
  name = "@THEME_NAME@",
  kind = "@THEME_KIND@",

  -- A gradient is a single color or { colors = { ... }, angle = degrees }
  active_border   = { colors = { "rgba(@ACCENT_H@ff)", "rgba(@ACCENT2_H@ff)" }, angle = 45 },
  inactive_border = "rgba(@OVERLAY_H@cc)",
  shadow_color    = "rgba(@SHADOW@)",

  rounding         = @ROUNDING@,
  border           = @BORDER@,
  gaps_in          = @GAPS_IN@,
  gaps_out         = @GAPS_OUT@,
  opacity_active   = @OPACITY_ACTIVE@,
  opacity_inactive = @OPACITY_INACTIVE@,
  blur_size        = @BLUR_SIZE@,
  blur_passes      = @BLUR_PASSES@,
  blur_vibrancy    = @BLUR_VIBRANCY@,
  shadow_range     = @SHADOW_RANGE@,
}
