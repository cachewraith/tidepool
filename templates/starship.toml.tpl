# Generated by tp-theme (@THEME_NAME@). Do not edit by hand; edit themes/@THEME_ID@/palette.sh
"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true
command_timeout = 800

format = """
[](fg:@ACCENT@)\
$os\
$username\
[](bg:@SURFACE@ fg:@ACCENT@)\
$directory\
[](fg:@SURFACE@)\
$git_branch\
$git_status\
$nodejs\
$php\
$python\
$rust\
$golang\
$java\
$docker_context\
$fill\
$cmd_duration\
$time
$character"""

[os]
disabled = false
style = "bg:@ACCENT@ fg:@ON_ACCENT@"
format = '[ $symbol ]($style)'

[os.symbols]
Arch = ""
Linux = ""
Ubuntu = ""
Debian = ""
Macos = ""
Windows = ""

[username]
show_always = true
style_user = "bg:@ACCENT@ fg:@ON_ACCENT@ bold"
style_root = "bg:@RED@ fg:@ON_ACCENT@ bold"
format = '[$user ]($style)'

[directory]
style = "bg:@SURFACE@ fg:@TEXT@ bold"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"
read_only = " "

[git_branch]
symbol = ""
style = "fg:@ACCENT2@"
format = '[ $symbol $branch]($style)'

[git_status]
style = "fg:@YELLOW@"
format = '[ $all_status$ahead_behind]($style)'

[nodejs]
symbol = ""
style = "fg:@GREEN@"
format = '[ $symbol $version]($style)'

[php]
symbol = ""
style = "fg:@MAUVE@"
format = '[ $symbol $version]($style)'

[python]
symbol = ""
style = "fg:@YELLOW@"
format = '[ $symbol $version]($style)'

[rust]
symbol = ""
style = "fg:@RED@"
format = '[ $symbol $version]($style)'

[golang]
symbol = ""
style = "fg:@BLUE@"
format = '[ $symbol $version]($style)'

[java]
symbol = ""
style = "fg:@RED@"
format = '[ $symbol $version]($style)'

[docker_context]
symbol = ""
style = "fg:@BLUE@"
format = '[ $symbol $context]($style)'
only_with_files = true

[fill]
symbol = " "

[cmd_duration]
min_time = 2000
style = "fg:@YELLOW@"
format = '[ took $duration ]($style)'

[time]
disabled = false
time_format = "%H:%M"
style = "fg:@SUBTEXT@"
format = '[ $time ]($style)'

[character]
success_symbol = "[❯](bold fg:@ACCENT@)"
error_symbol = "[❯](bold fg:@RED@)"
vimcmd_symbol = "[❮](bold fg:@GREEN@)"
