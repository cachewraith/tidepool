# Generated by tp-theme (@THEME_NAME@). Do not edit by hand; edit themes/@THEME_ID@/palette.sh

font_family      @FONT_MONO@
font_size        12.0
bold_font        auto
italic_font      auto
disable_ligatures never

foreground              @TEXT@
background              @BASE@
background_opacity      @WIN_ALPHA@
selection_foreground    @ON_ACCENT@
selection_background    @ACCENT@
cursor                  @ACCENT@
cursor_text_color       @BASE@
url_color               @BLUE@

# Smooth cursor: a short trail follows jumps
cursor_trail            3
cursor_trail_decay      0.1 0.4
cursor_shape            beam
cursor_blink_interval   0

window_padding_width    12
confirm_os_window_close 0
scrollback_lines        10000
sync_to_monitor         yes
repaint_delay           8
input_delay             2

# Bell: no beep, play the theme's sound instead
enable_audio_bell       no
command_on_bell         tp-sound bell

# Tab bar
tab_bar_edge            top
tab_bar_style           powerline
tab_powerline_style     slanted
active_tab_foreground   @ON_ACCENT@
active_tab_background   @ACCENT@
active_tab_font_style   bold
inactive_tab_foreground @SUBTEXT@
inactive_tab_background @SURFACE@
tab_bar_background      @MANTLE@

active_border_color     @ACCENT@
inactive_border_color   @OVERLAY@

color0  @ANSI_BLACK@
color8  @ANSI_BBLACK@
color1  @RED@
color9  @RED@
color2  @GREEN@
color10 @GREEN@
color3  @YELLOW@
color11 @YELLOW@
color4  @BLUE@
color12 @BLUE@
color5  @MAUVE@
color13 @MAUVE@
color6  @ACCENT2@
color14 @ACCENT2@
color7  @ANSI_WHITE@
color15 @ANSI_BWHITE@
